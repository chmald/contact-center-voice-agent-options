{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=centralus}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "realtimeModel": {
      "value": "${AZURE_OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini}"
    },
    "realtimeModelVersion": {
      "value": "${AZURE_OPENAI_REALTIME_MODEL_VERSION=}"
    },
    "realtimeDeploymentCapacity": {
      "value": "${REALTIME_DEPLOYMENT_CAPACITY=10}"
    },
    "deploySearch": {
      "value": "${DEPLOY_SEARCH=true}"
    },
    "deployCommunicationServices": {
      "value": "${DEPLOY_COMMUNICATION_SERVICES=true}"
    },
    "communicationDataLocation": {
      "value": "${ACS_DATA_LOCATION=United States}"
    }
  }
}
