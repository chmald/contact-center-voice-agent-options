T-IN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="762" y="947" width="54" height="18" as="geometry"/></mxCell><mxCell id="c8" value="off until enabled" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="820" y="946" width="109" height="20" as="geometry"/></mxCell><mxCell id="c9" value="OPTIONAL" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="939" y="947" width="67" height="18" as="geometry"/></mxCell><mxCell id="c10" value="off or local-only unless you add it" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1010" y="946" width="210" height="20" as="geometry"/></mxCell><mxCell id="c11" value="DIY" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="1230" y="947" width="40" height="18" as="geometry"/></mxCell><mxCell id="c12" value="customer-supplied, not an Azure service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1274" y="946" width="232" height="20" as="geometry"/></mxCell><mxCell id="howto_12" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Each tile is one product or component. Layers group them by role; the pill at the tile edge is its status. Voice Live and Realtime are the two GA options; the Foundry voice agent is public preview. Telephony providers default to none, so browser-only deployments never create ACS or Event Grid. Foundry portal native Twilio / Teams phone binding exists but this demo does not use it." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1820" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>