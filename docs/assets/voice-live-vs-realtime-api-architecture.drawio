h=2;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call-n4" target="call-n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e20l" value="2 IncomingCall" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e20"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="call-e21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="call-n6" target="call-n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e21l" value="3 webhook" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e21"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="call-e22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call-n8" target="call-n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e22l" value="4 reserve" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e22"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="call-e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="call-n10" target="call-n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e23l" value="no slot" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#A4262C;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e23"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="call-e24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0.8;" edge="1" parent="1" source="call-n8" target="call-n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e24l" value="5 answer_call (bidirectional media)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e24"><mxGeometry x="0.2" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="call-e25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;startArrow=classic;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="call-n4" target="call-n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e25l" value="6 media WebSocket" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e25"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="call-e26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;startArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="call-n12" target="call-n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e26l" value="7 AudioData" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e26"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="call-e27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#5C2D91;strokeWidth=2;dashed=0;startArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="call-n14" target="call-n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e27l" value="8 input_audio_buffer.append" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#5C2D91;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e27"><mxGeometry x="0.1" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="call-e28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#5C2D91;strokeWidth=2;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call-n14" target="call-n17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e28l" value="9 function call → RAG" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#5C2D91;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e28"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="call-m29" value="&lt;b&gt;10 · Agent speaks&lt;/b&gt; — upstream audio → bridge → &lt;i&gt;AudioData&lt;/i&gt; to ACS → caller.&lt;br&gt;&lt;b&gt;11 · Caller interrupts&lt;/b&gt; — upstream speech_started → bridge sends &lt;i&gt;StopAudio&lt;/i&gt; (ACS), &lt;i&gt;clear&lt;/i&gt; (Twilio), or &lt;i&gt;FLUSH_MEDIA&lt;/i&gt; (Asterisk) so queued speech stops.&lt;br&gt;&lt;b&gt;12 · Hang-up&lt;/b&gt; — media socket closes → bridge closes upstream → slot released → voice_session_end logged with channel." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="480" width="680" height="90" as="geometry" /></mxCell><mxCell id="call-m30" value="&lt;b&gt;Twilio path&lt;/b&gt;: Twilio number or SIP Domain → signed POST /telephony/twilio/voice (reserve slot) → TwiML &amp;lt;Connect&amp;gt;&amp;lt;Stream&amp;gt; with token → /telephony/twilio/media (claim) → μ-law 8 kHz ↔ PCM16 24 kHz → same bridge.&lt;br&gt;&lt;b&gt;Asterisk path&lt;/b&gt;: Dial(WebSocket/voice_agent/c(slin24)f(json)) → Asterisk connects to wss://&amp;lt;app&amp;gt;/telephony/asterisk/media (Basic auth = ASTERISK_WEBSOCKET_SECRET) → MEDIA_START → slin24 frames = bridge format (no resampling) → barge-in FLUSH_MEDIA; busy → HANGUP." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1700" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="deploy" name="4 - Deployment and regions"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="980" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="deploy-t1" value="What gets deployed where (shared single-endpoint mode)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#323130;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="40" as="geometry" /></mxCell><mxCell id="deploy-s2" value="One subscription. AI resources in AZURE_LOCATION; each app tier in AZURE_APP_LOCATION (set it when Container Apps capacity is constrained)." style="text;html=1;fontSiz