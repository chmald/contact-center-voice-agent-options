 width="62" height="62" as="geometry" /></mxCell><mxCell id="ways-m35" value="&lt;b&gt;Same per-resource Voice Live limits&lt;/b&gt;&lt;br&gt;Shared with the Voice Live app on the same resource&lt;br&gt;Agent Service: 60-min sessions · Entra ID only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="630" width="340" height="120" as="geometry" /></mxCell><mxCell id="ways-e36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B7791F;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-n30" target="ways-m31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B7791F;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-m31" target="ways-m32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B7791F;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-m32" target="ways-n33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B7791F;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-n33" target="ways-m35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-m40" value="&lt;b&gt;Same in all three:&lt;/b&gt; browser UI · ACS, Twilio, and Asterisk (chan_websocket) adapters · admission control · search_knowledge_base RAG tool (function tools are executed by the bridge; for the voice agent they are declared on the agent) · metrics · load probe. The voice agent is created from config/agent-profile.json by scripts/create-voice-agent.py (azd postprovision hook)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1720" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="call" name="3 - Phone call flow"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="780" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="call-t1" value="How a phone call reaches the agent (ACS shown; Twilio and Asterisk paths below)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#323130;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="40" as="geometry" /></mxCell><mxCell id="call-s2" value="Slots are reserved when the call arrives and claimed when media connects, so extra callers get the overflow number instead of dead air." style="text;html=1;fontSize=13;fontStyle=2;fontColor=#605E5C;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1720" height="30" as="geometry" /></mxCell><mxCell id="call-n3" value="&lt;b&gt;📞 Caller&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;dials the ACS number&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A4262C;strokeWidth=2;fontSize=12;fontColor=#A4262C;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="80" as="geometry" /></mxCell><mxCell id="call-n4" value="&lt;b&gt;Azure Communication Services&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Call Automation&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D