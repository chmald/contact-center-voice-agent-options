ddle;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="395" width="320" height="160" as="geometry" /></mxCell><mxCell id="ways-n22" value="&lt;b&gt;Your Global Standard deployment&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;gpt-realtime-2.1-mini · you manage version + upgrade&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=76;" vertex="1" parent="1"><mxGeometry x="1020" y="425" width="340" height="100" as="geometry" /></mxCell><mxCell id="ways-i23" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="1"><mxGeometry x="1030" y="444" width="62" height="62" as="geometry" /></mxCell><mxCell id="ways-m24" value="&lt;b&gt;Deployment capacity units&lt;/b&gt;&lt;br&gt;REALTIME_DEPLOYMENT_CAPACITY (default 10 = 100K TPM / 200 RPM)&lt;br&gt;Pooled per subscription + model version · fails at deploy AND under load" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="415" width="340" height="120" as="geometry" /></mxCell><mxCell id="ways-e25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-n19" target="ways-m20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-m20" target="ways-m21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-m21" target="ways-n22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-n22" target="ways-m24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-g29" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#B7791F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1720" height="200" as="geometry" /></mxCell><mxCell id="ways-n30" value="&lt;b&gt;Foundry voice agent&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;PREVIEW&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#B7791F;verticalAlign=middle;dashed=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="645" width="200" height="100" as="geometry" /></mxCell><mxCell id="ways-m31" value="No session.update and no greeting — the agent owns instructions, tools, voice, greeting, VAD, noise, echo, transcription; bridge streams audio and runs tools" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B7791F;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="635" width="320" height="120" as="geometry" /></mxCell><mxCell id="ways-m32" value="&lt;font face='Consolas'&gt;wss://&amp;lt;foundry&amp;gt;.services.ai.azure.com&lt;br&gt;/api/projects/&amp;lt;p&amp;gt;/agents/&amp;lt;a&amp;gt;&lt;br&gt;/endpoint/protocols/voice&lt;br&gt;?api-version=2025-11-15-preview&lt;br&gt;&lt;br&gt;Header: Foundry-Features:&lt;br&gt;VoiceAgents=V1Preview&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B7791F;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="615" width="320" height="160" as="geometry" /></mxCell><mxCell id="ways-n33" value="&lt;b&gt;Versioned agent in a Foundry project&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Managed gpt-realtime-2.1-mini · traces, stored audio, evaluations&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#B7791F;verticalAlign=middle;dashed=1;align=left;spacingLeft=76;" vertex="1" parent="1"><mxGeometry x="1020" y="645" width="340" height="100" as="geometry" /></mxCell><mxCell id="ways-i34" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/AI_Foundry.svg;" vertex="1" parent="1"><mxGeometry x="1030" y="664" width="62" height="62" as="geometry" /></mxCell><mxCell id="ways-m35" value="&lt;b&gt;Same per-resource Voice Live limits&lt;/b&gt;&lt;br&gt;Shared with the Voice Live app on the same resource&lt;br&gt;Agent Service: 60-min sessions · Entra ID only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="635" width="340" height="120" as="geometry" /></mxCell><mxCell id="ways-e36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B7791F;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-n30" target="ways-m31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B7791F;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-m31" target="ways-m32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e38" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B7791F;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-m32" target="ways-n33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B7791F;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-n33" target="ways-m35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-m40" value="&lt;b&gt;Same code in all three:&lt;/b&gt; browser UI · ACS, Twilio, and Asterisk (chan_websocket) adapters · per-app admission control · search_knowledge_base RAG tool (function tools are executed by the bridge; for the voice agent they are declared on the agent) · metrics · load probe. The voice agent is created from config/agent-profile.json by scripts/create-voice-agent.py (azd postprovision hook)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1720" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="call" name="3 - Phone call flow"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="820" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="call-t1" value="How a phone call reaches the agent (ACS shown; Twilio and Asterisk paths below)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#323130;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="40" as="geometry" /></mxCell><mxCell id="call-s2" value="ACS/Twilio reserve on the incoming webhook and claim on media; Asterisk admits on MEDIA_START. All channels share their app's SessionHub." style="text;html=1;fontSize=13;fontStyle=2;fontColor=#605E5C;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1720" height="30" as="geometry" /></mxCell><mxCell id="call-n3" value="&lt;b&gt;📞 Caller&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;dials the ACS number&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A4262C;strokeWidth=2;fontSize=12;fontColor=#A4262C;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="200" height="90" as="geometry" /></mxCell><mxCell id="call-n4" value="&lt;b&gt;Azure Communication Services&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Call Automation&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=69;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="260" height="90" as="geometry" /></mxCell><mxCell id="call-i5" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Azure_Communication_Services.svg;" vertex="1" parent="1"><mxGeometry x="330" y="157" width="55" height="55" as="geometry" /></mxCell><mxCell id="call-n6" value="&lt;b&gt;Event Grid&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;IncomingCall event&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="320" y="350" width="260" height="80" as="geometry" /></mxCell><mxCell id="call-i7" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/integration/Event_Grid_Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="330" y="365" width="49" height="49" as="geometry" /></mxCell><mxCell id="call-n8" value="&lt;b&gt;ACS event webhook&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;/telephony/acs/events · validates shared secret&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="720" y="350" width="300" height="80" as="geometry" /></mxCell><mxCell id="call-i9" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="730" y="365" width="49" height="49" as="geometry" /></mxCell><mxCell id="call-n10" value="&lt;b&gt;SessionHub · per app&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;reserve slot (30 s) · claim on media&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="520" width="300" height="80" as="geometry" /></mxCell><mxCell id="call-n11" value="&lt;b&gt;🔁 Overflow / busy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;ACS redirects to configured number or rejects&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE7E9;strokeColor=#A4262C;strokeWidth=2;fontSize=12;fontColor=#A4262C;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="320" y="520" width="260" height="80" as="geometry" /></mxCell><mxCell id="call-n12" value="&lt;b&gt;ACS media endpoint&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;/telephony/acs/media · per-call HMAC token&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=69;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="300" height="90" as="geometry" /></mxCell><mxCell id="call-i13" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="730" y="157" width="55" height="55" as="geometry" /></mxCell><mxCell id="call-n14" value="&lt;b&gt;Bridge&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;audio · barge-in · tool execution&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="140" width="220" height="90" as="geometry" /></mxCell><mxCell id="call-n15" value="&lt;b&gt;Upstream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Voice Live / Realtime / voice agent&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=12;fontColor=#5C2D91;verticalAlign=middle;dashed=0;align=left;spacingLeft=69;" vertex="1" parent="1"><mxGeometry x="1530" y="140" width="230" height="90" as="geometry" /></mxCell><mxCell id="call-i16" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/Speech_Services.svg;" vertex="1" parent="1"><mxGeometry x="1540" y="157" width="55" height="55" as="geometry" /></mxCell><mxCell id="call-n17" value="&lt;b&gt;search_knowledge_base · executed by the bridge&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Azure AI Search (managed identity), or local JSON&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#036C70;strokeWidth=2;fontSize=12;fontColor=#036C70;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1180" y="350" width="580" height="80" as="geometry" /></mxCell><mxCell id="call-i18" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/app_services/Search_Services.svg;" vertex="1" parent="1"><mxGeometry x="1190" y="365" width="49" height="49" as="geometry" /></mxCell><mxCell id="call-e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="call-n3" target="call-n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e19l" value="1 · Call" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#A4262C;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e19"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset" /></mxGeometry></mxCell><mxCell id="call-e20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call-n4" target="call-n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e20l" value="2 · IncomingCall" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e20"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="call-e21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="call-n6" target="call-n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e21l" value="3 · Webhook" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e21"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="call-e22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call-n8" target="call-n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e22l" value="4 · Reserve" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e22"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="call-e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="call-n10" target="call-n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e23l" value="no slot" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#A4262C;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e23"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="call-e24" style="rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0.8;" edge="1" parent="1" source="call-n8" target="call-n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="280" /><mxPoint x="635" y="280" /><mxPoint x="635" y="212" /></Array></mxGeometry></mxCell><mxCell id="call-e24l" value="5 · Answer call + start media" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e24"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="-16" as="offset" /></mxGeometry></mxCell><mxCell id="call-e25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;startArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="call-n4" target="call-n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e25l" value="6 · WSS media" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e25"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset" /></mxGeometry></mxCell><mxCell id="call-e26" style="rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=1;exitX=1;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="call-n12" target="call-n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="212" /><mxPoint x="1090" y="560" /></Array></mxGeometry></mxCell><mxCell id="call-e26l" value="claim slot" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e26"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="35" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="call-e27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;dashed=0;startArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="call-n12" target="call-n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e27l" value="7 · PCM24 audio" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#0078D4;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e27"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset" /></mxGeometry></mxCell><mxCell id="call-e28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#5C2D91;strokeWidth=2;dashed=0;startArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="call-n14" target="call-n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e28l" value="8 · Audio + events" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#5C2D91;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e28"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset" /></mxGeometry></mxCell><mxCell id="call-e29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#036C70;strokeWidth=2;dashed=0;startArrow=classic;exitX=0.5;exitY=1;entryX=0.19;entryY=0;" edge="1" parent="1" source="call-n14" target="call-n17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="call-e29l" value="9 · Tool call / result" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#036C70;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="call-e29"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="call-m30" value="&lt;b&gt;Upstream direction&lt;/b&gt;&lt;br&gt;In: input_audio_buffer.append&lt;br&gt;Out: audio deltas + events" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4EFFA;strokeColor=#5C2D91;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1470" y="250" width="290" height="75" as="geometry" /></mxCell><mxCell id="call-m31" value="&lt;b&gt;10 · Agent speaks&lt;/b&gt; — upstream audio → bridge → &lt;i&gt;AudioData&lt;/i&gt; to ACS → caller.&lt;br&gt;&lt;b&gt;11 · Caller interrupts&lt;/b&gt; — upstream speech_started → bridge sends &lt;i&gt;StopAudio&lt;/i&gt; (ACS), &lt;i&gt;clear&lt;/i&gt; (Twilio), or &lt;i&gt;FLUSH_MEDIA&lt;/i&gt; (Asterisk) so queued speech stops.&lt;br&gt;&lt;b&gt;12 · Hang-up&lt;/b&gt; — media socket closes → bridge closes upstream → slot released → voice_session_end logged with channel." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1180" y="480" width="580" height="140" as="geometry" /></mxCell><mxCell id="call-m32" value="&lt;b&gt;Twilio path&lt;/b&gt;: Twilio number or SIP Domain → signed POST /telephony/twilio/voice (reserve slot) → TwiML &amp;lt;Connect&amp;gt;&amp;lt;Stream&amp;gt; with token → /telephony/twilio/media (claim) → μ-law 8 kHz ↔ PCM16 24 kHz → same bridge.&lt;br&gt;&lt;b&gt;Full:&lt;/b&gt; busy message, with a Dial fallback when an overflow number is configured." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="840" height="100" as="geometry" /></mxCell><mxCell id="call-m33" value="&lt;b&gt;Asterisk path&lt;/b&gt;: Dial(WebSocket/voice_agent/c(slin24)f(json)) → WSS /telephony/asterisk/media (Basic auth: ASTERISK_WEBSOCKET_SECRET) → MEDIA_START → admission → slin24 frames = bridge format (no resampling).&lt;br&gt;&lt;b&gt;Full:&lt;/b&gt; HANGUP; configure the dialplan fallback. Barge-in uses FLUSH_MEDIA." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="920" y="660" width="840" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="deploy" name="4 - Deployment and regions"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="deploy-t1" value="What gets deployed where (shared-resource mode)" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#323130;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="40" as="geometry" /></mxCell><mxCell id="deploy-s2" value="One subscription. AI resources in AZURE_LOCATION; each app tier in AZURE_APP_LOCATION (set it when Container Apps capacity is constrained)." style="text;html=1;fontSize=13;fontStyle=2;fontColor=#605E5C;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1720" height="30" as="geometry" /></mxCell><mxCell id="deploy-g3" value="Subscription (AZURE_SUBSCRIPTION_ID)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#605E5C;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#605E5C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1720" height="970" as="geometry" /></mxCell><mxCell id="deploy-g4" value="platform/ · rg-&amp;lt;platform-env&amp;gt; · AZURE_LOCATION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5C2D91;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#5C2D91;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="620" height="610" as="geometry" /></mxCell><mxCell id="deploy-g5" value="ONE Foundry resource · AIServices S0" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAF8FF;strokeColor=#5C2D91;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#5C2D91;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="200" width="580" height="310" as="geometry" /></mxCell><mxCell id="deploy-n6" value="&lt;b&gt;Managed Voice Live models&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;disableLocalAuth · allowProjectManagement&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=12;fontColor=#5C2D91;verticalAlign=middle;dashed=0;align=left;spacingLeft=51;" vertex="1" parent="1"><mxGeometry x="110" y="240" width="540" height="60" as="geometry" /></mxCell><mxCell id="deploy-i7" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/AI_Foundry.svg;" vertex="1" parent="1"><mxGeometry x="120" y="251" width="37" height="37" as="geometry" /></mxCell><mxCell id="deploy-n8" value="&lt;b&gt;Realtime deployment&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;GlobalStandard · REALTIME_DEPLOYMENT_CAPACITY units (1 = 10K TPM + 20 RPM)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=12;fontColor=#5C2D91;verticalAlign=middle;dashed=0;align=left;spacingLeft=57;" vertex="1" parent="1"><mxGeometry x="110" y="320" width="540" height="70" as="geometry" /></mxCell><mxCell id="deploy-i9" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="1"><mxGeometry x="120" y="333" width="43" height="43" as="geometry" /></mxCell><mxCell id="deploy-n10" value="&lt;b&gt;Project 'voice-agents'&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;holds the Foundry voice agent (preview)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#B7791F;verticalAlign=middle;dashed=1;align=left;spacingLeft=57;" vertex="1" parent="1"><mxGeometry x="110" y="410" width="540" height="70" as="geometry" /></mxCell><mxCell id="deploy-i11" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/AI_Foundry.svg;" vertex="1" parent="1"><mxGeometry x="120" y="423" width="43" height="43" as="geometry" /></mxCell><mxCell id="deploy-n12" value="&lt;b&gt;Azure AI Search · separate resource&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Basic · semantic ranker · key auth off · 'knowledge' index (40 articles)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#036C70;strokeWidth=2;fontSize=12;fontColor=#036C70;verticalAlign=middle;dashed=0;align=left;spacingLeft=57;" vertex="1" parent="1"><mxGeometry x="100" y="530" width="560" height="70" as="geometry" /></mxCell><mxCell id="deploy-i13" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/app_services/Search_Services.svg;" vertex="1" parent="1"><mxGeometry x="110" y="543" width="43" height="43" as="geometry" /></mxCell><mxCell id="deploy-n14" value="&lt;b&gt;Communication Services · optional&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;global · configure a number or Direct Routing for ACS calls&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=57;" vertex="1" parent="1"><mxGeometry x="100" y="620" width="560" height="70" as="geometry" /></mxCell><mxCell id="deploy-i15" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Azure_Communication_Services.svg;" vertex="1" parent="1"><mxGeometry x="110" y="633" width="43" height="43" as="geometry" /></mxCell><mxCell id="deploy-m16" value="&lt;b&gt;Platform preprovision:&lt;/b&gt; check-realtime-quota.ps1 -Platform&lt;br&gt;Checks quota for the shared Realtime deployment before provisioning." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="700" width="560" height="45" as="geometry" /></mxCell><mxCell id="deploy-g17" value="examples/voice-live-api · rg-&amp;lt;env&amp;gt; · AZURE_APP_LOCATION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#0078D4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="960" height="290" as="geometry" /></mxCell><mxCell id="deploy-n18" value="&lt;b&gt;Container App&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;one replica · browser + phone channels&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="790" y="200" width="280" height="80" as="geometry" /></mxCell><mxCell id="deploy-i19" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="800" y="215" width="49" height="49" as="geometry" /></mxCell><mxCell id="deploy-n20" value="&lt;b&gt;Container Registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;remote build · AcrPull&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1090" y="200" width="280" height="80" as="geometry" /></mxCell><mxCell id="deploy-i21" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="1100" y="215" width="49" height="49" as="geometry" /></mxCell><mxCell id="deploy-n22" value="&lt;b&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;console logs&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1390" y="200" width="300" height="80" as="geometry" /></mxCell><mxCell id="deploy-i23" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="1400" y="215" width="49" height="49" as="geometry" /></mxCell><mxCell id="deploy-n24" value="&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;keyless access · roles listed at left&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=69;" vertex="1" parent="1"><mxGeometry x="790" y="305" width="280" height="90" as="geometry" /></mxCell><mxCell id="deploy-i25" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="800" y="322" width="55" height="55" as="geometry" /></mxCell><mxCell id="deploy-m26" value="&lt;b&gt;Per-app admission&lt;/b&gt;&lt;br&gt;Browser, ACS, Twilio and Asterisk share this app's SessionHub.&lt;br&gt;The other two apps have their own counters." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="305" width="600" height="90" as="geometry" /></mxCell><mxCell id="deploy-g27" value="examples/realtime-api · rg-&amp;lt;env&amp;gt; · AZURE_APP_LOCATION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#0078D4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="450" width="960" height="290" as="geometry" /></mxCell><mxCell id="deploy-n28" value="&lt;b&gt;Container App&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;one replica · browser + phone channels&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="790" y="500" width="280" height="80" as="geometry" /></mxCell><mxCell id="deploy-i29" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="800" y="515" width="49" height="49" as="geometry" /></mxCell><mxCell id="deploy-n30" value="&lt;b&gt;Container Registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;remote build · AcrPull&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1090" y="500" width="280" height="80" as="geometry" /></mxCell><mxCell id="deploy-i31" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="1100" y="515" width="49" height="49" as="geometry" /></mxCell><mxCell id="deploy-n32" value="&lt;b&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;console logs&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1390" y="500" width="300" height="80" as="geometry" /></mxCell><mxCell id="deploy-i33" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="1400" y="515" width="49" height="49" as="geometry" /></mxCell><mxCell id="deploy-n34" value="&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;keyless access · roles listed at left&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=69;" vertex="1" parent="1"><mxGeometry x="790" y="605" width="280" height="90" as="geometry" /></mxCell><mxCell id="deploy-i35" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="800" y="622" width="55" height="55" as="geometry" /></mxCell><mxCell id="deploy-m36" value="&lt;b&gt;Realtime preprovision&lt;/b&gt;&lt;br&gt;Quota check skips in shared mode: the platform owns the deployment.&lt;br&gt;Standalone mode checks quota in this example instead." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="605" width="600" height="90" as="geometry" /></mxCell><mxCell id="deploy-g37" value="examples/foundry-voice-agent (preview) · rg-&amp;lt;env&amp;gt; · AZURE_APP_LOCATION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#B7791F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="750" width="960" height="290" as="geometry" /></mxCell><mxCell id="deploy-n38" value="&lt;b&gt;Container App&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;one replica · browser + phone channels&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="790" y="800" width="280" height="80" as="geometry" /></mxCell><mxCell id="deploy-i39" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="800" y="815" width="49" height="49" as="geometry" /></mxCell><mxCell id="deploy-n40" value="&lt;b&gt;Container Registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;remote build · AcrPull&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1090" y="800" width="280" height="80" as="geometry" /></mxCell><mxCell id="deploy-i41" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="1100" y="815" width="49" height="49" as="geometry" /></mxCell><mxCell id="deploy-n42" value="&lt;b&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;console logs&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1390" y="800" width="300" height="80" as="geometry" /></mxCell><mxCell id="deploy-i43" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="1400" y="815" width="49" height="49" as="geometry" /></mxCell><mxCell id="deploy-n44" value="&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;keyless access · roles listed at left&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=69;" vertex="1" parent="1"><mxGeometry x="790" y="905" width="280" height="90" as="geometry" /></mxCell><mxCell id="deploy-i45" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="800" y="922" width="55" height="55" as="geometry" /></mxCell><mxCell id="deploy-m46" value="&lt;b&gt;Voice-agent postprovision&lt;/b&gt;&lt;br&gt;create-voice-agent.py publishes the agent in the shared project.&lt;br&gt;Repeat after profile edits; the bridge still executes function tools." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#B7791F;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090" y="905" width="600" height="90" as="geometry" /></mxCell><mxCell id="deploy-m47" value="&lt;b&gt;Deploy&lt;/b&gt;: platform azd provision → load-knowledge-index.py →&lt;br&gt;use-shared-platform.ps1 -Example &amp;lt;x&amp;gt; → azd up per example.&lt;br&gt;&lt;b&gt;Optional phones&lt;/b&gt;: select acs, twilio, asterisk; configure the provider.&lt;br&gt;Use configure-telephony.ps1 for ACS/Twilio or Asterisk websocket_client.conf.&lt;br&gt;&lt;b&gt;Standalone instead&lt;/b&gt;: each example owns its Foundry resource + project; knowledge/ can supply Search via use-knowledge-base.ps1." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="780" width="620" height="130" as="geometry" /></mxCell><mxCell id="deploy-m48" value="&lt;b&gt;Roles granted to each app identity&lt;/b&gt; (shared-access.bicep)&lt;br&gt;• Foundry: Cognitive Services User + Foundry User (Voice Live, voice agent) or Cognitive Services OpenAI User (Realtime)&lt;br&gt;• Azure AI Search: Search Index Data Reader · ACS: Contributor (Call Automation)&lt;br&gt;• Deploying user: Foundry/OpenAI roles + Search contributor roles (agent creation, index load)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4EFFA;strokeColor=#5C2D91;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="930" width="620" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
