y x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="arch-e52" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#5C2D91;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-n18" target="arch-n34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-e52l" value="deployment" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#5C2D91;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="arch-e52"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="arch-e53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#B7791F;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-n20" target="arch-n36"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-e53l" value="project route" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#B7791F;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="arch-e53"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="arch-e54" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#036C70;strokeWidth=2;dashed=0;startArrow=classic;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-n29" target="arch-n38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-e54l" value="HTTPS query" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#036C70;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="arch-e54"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset" /></mxGeometry></mxCell><mxCell id="arch-m55" value="&lt;b&gt;When an app is full:&lt;/b&gt; browser → busy + close 1013; ACS/Twilio → configured overflow number or busy/reject; Asterisk → HANGUP (dialplan handles fallback). No built-in human queue.&lt;br&gt;&lt;b&gt;Standalone mode:&lt;/b&gt; each example has its own Foundry resource + project. Shared mode pools Voice Live service limits, not the three apps' admission counters. Confirm effective service limits before sizing." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1820" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ways" name="2 - Three ways to connect"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ways-t1" value="Three ways to connect the shared bridge implementation" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#323130;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="40" as="geometry" /></mxCell><mxCell id="ways-s2" value="What each app sends, its upstream route, where the model lives, and what limits capacity. Endpoint lines wrap for readability." style="text;html=1;fontSize=13;fontStyle=2;fontColor=#605E5C;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1720" height="30" as="geometry" /></mxCell><mxCell id="ways-h3" value="What the bridge sends" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#323130;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="320" height="30" as="geometry" /></mxCell><mxCell id="ways-h4" value="WebSocket endpoint" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#323130;align=center;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="320" height="30" as="geometry" /></mxCell><mxCell id="ways-h5" value="Model / agent" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#323130;align=center;" vertex="1" parent="1"><mxGeometry x="1020" y="110" width="320" height="30" as="geometry" /></mxCell><mxCell id="ways-h6" value="What limits capacity" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#323130;align=center;" vertex="1" parent="1"><mxGeometry x="1400" y="110" width="360" height="30" as="geometry" /></mxCell><mxCell id="ways-g7" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5C2D91;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#5C2D91;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1720" height="200" as="geometry" /></mxCell><mxCell id="ways-n8" value="&lt;b&gt;Voice Live API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;GA&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=12;fontColor=#5C2D91;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="200" height="100" as="geometry" /></mxCell><mxCell id="ways-m9" value="session.update with instructions, tools, voice, VAD, noise, echo, transcription (flat schema)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="195" width="320" height="120" as="geometry" /></mxCell><mxCell id="ways-m10" value="&lt;font face='Consolas'&gt;wss://&amp;lt;foundry&amp;gt;.services.ai.azure.com&lt;br&gt;/voice-live/realtime&lt;br&gt;?api-version=2026-07-15&lt;br&gt;&amp;amp;model=gpt-realtime-mini&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="175" width="320" height="160" as="geometry" /></mxCell><mxCell id="ways-n11" value="&lt;b&gt;Managed model&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;No deployment · service-managed lifecycle&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=12;fontColor=#5C2D91;verticalAlign=middle;dashed=0;align=left;spacingLeft=76;" vertex="1" parent="1"><mxGeometry x="1020" y="205" width="340" height="100" as="geometry" /></mxCell><mxCell id="ways-i12" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/Speech_Services.svg;" vertex="1" parent="1"><mxGeometry x="1030" y="224" width="62" height="62" as="geometry" /></mxCell><mxCell id="ways-m13" value="&lt;b&gt;Per-resource Voice Live limits&lt;/b&gt;&lt;br&gt;100 new connections/min · ≤120K TPM · 60-min sessions&lt;br&gt;Raise via support request · fails under load" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="195" width="340" height="120" as="geometry" /></mxCell><mxCell id="ways-e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#5C2D91;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-n8" target="ways-m9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#5C2D91;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ways-m9" target="ways-m10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ways-e16" style="edgeStyle=orth