<mxfile host="Electron" modified="2026-09-29T00:00:00.000Z" version="26.0.0"><diagram id="arch" name="1 - Solution architecture"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arch-t1" value="Voice agent comparison: three upstreams, one bridge, one AI endpoint" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#323130;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry" /></mxCell><mxCell id="arch-s2" value="Browser and phone callers reach the same FastAPI WebSocket bridge. Each example app differs only in the upstream it talks to." style="text;html=1;fontSize=13;fontStyle=2;fontColor=#605E5C;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1820" height="30" as="geometry" /></mxCell><mxCell id="arch-g3" value="👥 Callers" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#A4262C;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#A4262C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="640" as="geometry" /></mxCell><mxCell id="arch-n4" value="&lt;b&gt;🎙️ Browser&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Microphone · PCM16 24 kHz&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A4262C;strokeWidth=2;fontSize=12;fontColor=#A4262C;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="210" height="70" as="geometry" /></mxCell><mxCell id="arch-n5" value="&lt;b&gt;📞 PSTN caller&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Any phone&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A4262C;strokeWidth=2;fontSize=12;fontColor=#A4262C;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="210" height="70" as="geometry" /></mxCell><mxCell id="arch-n6" value="&lt;b&gt;☎️ PBX (Asterisk)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;SIP trunk via Twilio, or WSS media (Asterisk chan_websocket)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A4262C;strokeWidth=2;fontSize=12;fontColor=#A4262C;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="210" height="80" as="geometry" /></mxCell><mxCell id="arch-n7" value="&lt;b&gt;🏢 Contact center / SBC&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Existing platform&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#A4262C;strokeWidth=2;fontSize=12;fontColor=#A4262C;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="210" height="80" as="geometry" /></mxCell><mxCell id="arch-g8" value="📡 Telephony (optional)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#0078D4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="290" height="640" as="geometry" /></mxCell><mxCell id="arch-n9" value="&lt;b&gt;Azure Communication Services&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Phone number or Direct Routing · Call Automation&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=69;" vertex="1" parent="1"><mxGeometry x="350" y="250" width="250" height="90" as="geometry" /></mxCell><mxCell id="arch-i10" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Azure_Communication_Services.svg;" vertex="1" parent="1"><mxGeometry x="360" y="267" width="55" height="55" as="geometry" /></mxCell><mxCell id="arch-n11" value="&lt;b&gt;Event Grid&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;IncomingCall → /telephony/acs/events&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=57;" vertex="1" parent="1"><mxGeometry x="350" y="380" width="250" height="70" as="geometry" /></mxCell><mxCell id="arch-i12" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/integration/Event_Grid_Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="360" y="393" width="43" height="43" as="geometry" /></mxCell><mxCell id="arch-n13" value="&lt;b&gt;Twilio&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Number or SIP Domain · Media Streams&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="580" width="250" height="80" as="geometry" /></mxCell><mxCell id="arch-g14" value="⚡ App tier · Azure Container Apps · region AZURE_APP_LOCATION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#0078D4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="110" width="520" height="830" as="geometry" /></mxCell><mxCell id="arch-m15" value="&lt;b&gt;Shared core (identical in every app)&lt;/b&gt;&lt;br&gt;• /ws browser · /telephony/acs · /telephony/twilio · /telephony/asterisk&lt;br&gt;• Audio adapters: PCM 24 kHz (ACS, Asterisk slin24) · μ-law 8 kHz ↔ 24 kHz (Twilio)&lt;br&gt;• SessionHub: one admission cap (MAX_CONCURRENT_SESSIONS), overflow → human queue&lt;br&gt;• RealtimeStyleBridge: barge-in, tool calls, history trim, metrics&lt;br&gt;• Tools: search_knowledge_base (RAG) · record lookup · time" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;fontSize=11;fontColor=#323130;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="160" width="460" height="150" as="geometry" /></mxCell><mxCell id="arch-n16" value="&lt;b&gt;examples/voice-live-api&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;VoiceLiveBridge · sends instructions + tools&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=57;" vertex="1" parent="1"><mxGeometry x="690" y="350" width="460" height="70" as="geometry" /></mxCell><mxCell id="arch-i17" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="700" y="363" width="43" height="43" as="geometry" /></mxCell><mxCell id="arch-n18" value="&lt;b&gt;examples/realtime-api&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;RealtimeApiBridge · GA nested schema&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=57;" vertex="1" parent="1"><mxGeometry x="690" y="450" width="460" height="70" as="geometry" /></mxCell><mxCell id="arch-i19" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="700" y="463" width="43" height="43" as="geometry" /></mxCell><mxCell id="arch-n20" value="&lt;b&gt;examples/foundry-voice-agent  (preview)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;VoiceAgentBridge · no session config · agent owns greeting + audio&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#B7791F;verticalAlign=middle;dashed=1;align=left;spacingLeft=57;" vertex="1" parent="1"><mxGeometry x="690" y="550" width="460" height="70" as="geometry" /></mxCell><mxCell id="arch-i21" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="700" y="563" width="43" height="43" as="geometry" /></mxCell><mxCell id="arch-n22" value="&lt;b&gt;Container Registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;remote build&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=51;" vertex="1" parent="1"><mxGeometry x="690" y="660" width="220" height="60" as="geometry" /></mxCell><mxCell id="arch-i23" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/containers/Container_Registries.svg;" vertex="1" parent="1"><mxGeometry x="700" y="671" width="37" height="37" as="geometry" /></mxCell><mxCell id="arch-n24" value="&lt;b&gt;Log Analytics&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;voice_turn · channel&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=51;" vertex="1" parent="1"><mxGeometry x="930" y="660" width="220" height="60" as="geometry" /></mxCell><mxCell id="arch-i25" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/analytics/Log_Analytics_Workspaces.svg;" vertex="1" parent="1"><mxGeometry x="940" y="671" width="37" height="37" as="geometry" /></mxCell><mxCell id="arch-n26" value="&lt;b&gt;Managed identity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Entra ID · no keys&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontColor=#0078D4;verticalAlign=middle;dashed=0;align=left;spacingLeft=51;" vertex="1" parent="1"><mxGeometry x="690" y="740" width="220" height="60" as="geometry" /></mxCell><mxCell id="arch-i27" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="700" y="751" width="37" height="37" as="geometry" /></mxCell><mxCell id="arch-m28" value="One replica per app so the admission cap is global.&lt;br&gt;Browser tabs and phone calls share the same counter." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="930" y="740" width="220" height="80" as="geometry" /></mxCell><mxCell id="arch-g29" value="🧠 AI tier · ONE Foundry resource · region AZURE_LOCATION (e.g. centralus)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5C2D91;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#5C2D91;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="640" height="830" as="geometry" /></mxCell><mxCell id="arch-n30" value="&lt;b&gt;Voice Live API · model mode&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Managed gpt-realtime-mini · no deployment&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=12;fontColor=#5C2D91;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1250" y="340" width="580" height="80" as="geometry" /></mxCell><mxCell id="arch-i31" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/Speech_Services.svg;" vertex="1" parent="1"><mxGeometry x="1260" y="355" width="49" height="49" as="geometry" /></mxCell><mxCell id="arch-n32" value="&lt;b&gt;Azure OpenAI Realtime API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Global Standard deployment gpt-realtime-2.1-mini&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=12;fontColor=#5C2D91;verticalAlign=middle;dashed=0;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1250" y="440" width="580" height="80" as="geometry" /></mxCell><mxCell id="arch-i33" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;" vertex="1" parent="1"><mxGeometry x="1260" y="455" width="49" height="49" as="geometry" /></mxCell><mxCell id="arch-n34" value="&lt;b&gt;Foundry voice agent (project route)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;Project 'voice-agents' · versioned agent · managed gpt-realtime-2.1-mini&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#B7791F;verticalAlign=middle;dashed=1;align=left;spacingLeft=63;" vertex="1" parent="1"><mxGeometry x="1250" y="540" width="580" height="80" as="geometry" /></mxCell><mxCell id="arch-i35" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/ai_machine_learning/AI_Foundry.svg;" vertex="1" parent="1"><mxGeometry x="1260" y="555" width="49" height="49" as="geometry" /></mxCell><mxCell id="arch-n36" value="&lt;b&gt;Azure AI Search&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#323130'&gt;index 'knowledge' · keyword + semantic ranker · called by the shared RAG tool (managed identity)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5C2D91;strokeWidth=2;fontSize=12;fontColor=#5C2D91;verticalAlign=middle;dashed=0;align=left;spacingLeft=57;" vertex="1" parent="1"><mxGeometry x="1250" y="680" width="580" height="70" as="geometry" /></mxCell><mxCell id="arch-i37" value="" style="aspect=fixed;html=1;points=[];image;image=img/lib/azure2/app_services/Search_Services.svg;" vertex="1" parent="1"><mxGeometry x="1260" y="693" width="43" height="43" as="geometry" /></mxCell><mxCell id="arch-m38" value="&lt;b&gt;Capacity&lt;/b&gt;&lt;br&gt;• Voice Live + voice agent: per-resource Voice Live limits (100 new connections/min, ≤120K TPM) — &lt;b&gt;shared&lt;/b&gt; by both&lt;br&gt;• Realtime: deployment capacity units (1 = 10K TPM + 20 RPM; often 10 = 100K TPM) — separate pool&lt;br&gt;• Voice agent is &lt;b&gt;public preview&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B7791F;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="160" width="580" height="130" as="geometry" /></mxCell><mxCell id="arch-e39" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="arch-n4" target="arch-m15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch-e39l" value="WSS /ws" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#A4262C;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" connectable="0" vertex="1" parent="arch-e39"><mxGeometry x="-0.5" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="arch-e40" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="arch-n5" target="arch-n9"><mxGeometry relative="1" as="geometry" />