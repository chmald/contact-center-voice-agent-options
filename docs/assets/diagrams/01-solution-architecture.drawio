        </mxCell>
        <mxCell id="arch-m15" value="&lt;b&gt;Shared core code (runs separately in each app)&lt;/b&gt;&lt;br&gt;• /ws browser · /telephony/acs · /telephony/twilio · /telephony/asterisk&lt;br&gt;• Audio adapters: PCM 24 kHz (ACS, Asterisk slin24) · μ-law 8 kHz ↔ 24 kHz (Twilio)&lt;br&gt;• SessionHub: MAX_CONCURRENT_SESSIONS per app, shared across its channels&lt;br&gt;• RealtimeStyleBridge: barge-in, tool calls, history trim, metrics&lt;br&gt;• Tools: search_knowledge_base (RAG) · record lookup · time" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;fontSize=11;fontColor=#323130;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="690" y="160" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="arch-n16" value="&lt;b&gt;examples/voice-live-api&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;&lt;font style='font-size:10px' color='#323130'&gt;VoiceLiveBridge · sends instructions + tools&lt;/font&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1">
