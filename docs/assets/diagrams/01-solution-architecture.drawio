        <mxCell id="arch-n38" value="&lt;b&gt;Azure AI Search · separate resource&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;&lt;font style='font-size:10px' color='#323130'&gt;index 'knowledge' · 40 articles · keyword + semantic ranker&lt;/font&gt;&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;fillColor=#FFFFFF;strokeColor=#036C70;strokeWidth=1.5;fontSize=12;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1">
