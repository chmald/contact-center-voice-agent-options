        </mxCell>
        <mxCell id="arch-m40" value="&lt;b&gt;Shared data, app-side tools&lt;/b&gt;&lt;br&gt;RAG can also use local knowledge-base.json when Search is not configured.&lt;br&gt;Record lookup reads 30 local sample-data.json records, not the Search index." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0FAFA;strokeColor=#036C70;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
