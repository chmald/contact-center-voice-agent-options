        <mxCell id="title" value="&lt;b&gt;Voice agent comparison: three apps, shared bridge code, one Foundry resource&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1">
