        <mxCell id="subtitle" value="Shared-platform mode shown. Each app uses a distinct upstream route; browser and phone channels reuse the same bridge implementation." style="text;html=1;fontSize=13;fontStyle=0;fontColor=#605E5C;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
