        <mxCell id="arch-g14" value="App tier · each app in AZURE_APP_LOCATION" style="shape=label;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0078D4;dashed=1;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#0078D4;strokeWidth=2;align=left;verticalAlign=top;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontFamily=Segoe UI;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1">
