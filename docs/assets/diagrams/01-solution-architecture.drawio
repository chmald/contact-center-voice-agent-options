        <mxCell id="arch-m28" value="One replica per app; one counter for its browser + phone sessions.&lt;br&gt;ACR, logs and identity are also per app." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
