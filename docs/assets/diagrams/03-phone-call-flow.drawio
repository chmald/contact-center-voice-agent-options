        <mxCell id="call-m30" value="&lt;b&gt;Upstream direction&lt;/b&gt;&lt;br&gt;In: input_audio_buffer.append&lt;br&gt;Out: audio deltas + events" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4EFFA;strokeColor=#5C2D91;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1470" y="250" width="290" height="75" as="geometry" />
        </mxCell>
        <mxCell id="call-m31" value="&lt;b&gt;10 · Agent speaks&lt;/b&gt; — upstream audio → bridge → &lt;i&gt;AudioData&lt;/i&gt; to ACS → caller.&lt;br&gt;&lt;b&gt;11 · Caller interrupts&lt;/b&gt; — upstream speech_started → bridge sends &lt;i&gt;StopAudio&lt;/i&gt; (ACS), &lt;i&gt;clear&lt;/i&gt; (Twilio), or &lt;i&gt;FLUSH_MEDIA&lt;/i&gt; (Asterisk) so queued speech stops.&lt;br&gt;&lt;b&gt;12 · Hang-up&lt;/b&gt; — media socket closes → bridge closes upstream → slot released → voice_session_end logged with channel." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1180" y="480" width="580" height="140" as="geometry" />
        </mxCell>
        <mxCell id="call-m32" value="&lt;b&gt;Twilio path&lt;/b&gt;: Twilio number or SIP Domain → signed POST /telephony/twilio/voice (reserve slot) → TwiML &amp;lt;Connect&amp;gt;&amp;lt;Stream&amp;gt; with token → /telephony/twilio/media (claim) → μ-law 8 kHz ↔ PCM16 24 kHz → same bridge.&lt;br&gt;&lt;b&gt;Full:&lt;/b&gt; busy message, with a Dial fallback when an overflow number is configured." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="840" height="100" as="geometry" />
        </mxCell>
        <mxCell id="call-m33" value="&lt;b&gt;Asterisk path&lt;/b&gt;: Dial(WebSocket/voice_agent/c(slin24)f(json)) → WSS /telephony/asterisk/media (Basic auth: ASTERISK_WEBSOCKET_SECRET) → MEDIA_START → admission → slin24 frames = bridge format (no resampling).&lt;br&gt;&lt;b&gt;Full:&lt;/b&gt; HANGUP; configure the dialplan fallback. Barge-in uses FLUSH_MEDIA." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;fontSize=11;fontColor=#323130;align=left;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="920" y="660" width="840" height="100" as="geometry" />
        </mxCell>
