        <mxCell id="title" value="&lt;b&gt;How a phone call reaches the agent (ACS shown; Twilio and Asterisk paths below)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="ACS/Twilio reserve on the incoming webhook and claim on media; Asterisk admits on MEDIA_START. All channels share their app's SessionHub." style="text;html=1;fontSize=13;fontStyle=0;fontColor=#605E5C;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
