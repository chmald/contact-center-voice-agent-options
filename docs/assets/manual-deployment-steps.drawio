<mxfile host="Electron" version="26.0.0"><diagram id="p1" name="Manual deployment steps"><mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1900" height="6" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1040" y="0" width="860" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Manual deployment runbook: no azd, no Bicep&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="docs/03b as a map: seven phases of Azure CLI and portal steps, each with the proof that closes it. Typical total ~45-60 min, versus ~10-15 min per example with azd." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1820" height="40" as="geometry"/></mxCell><mxCell id="footer" value="Voice Live vs Realtime API  |  Manual deployment runbook  |  v1.4.2  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="1820" height="20" as="geometry"/></mxCell><mxCell id="p0" value="Phase 0 - Authenticate&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#605E5C&quot;&gt;typical 2-5 min&lt;/font&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;fontFamily=Segoe UI;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="340" as="geometry"/></mxCell><mxCell id="p0_s0" value="&lt;b style=&quot;font-size:11px&quot;&gt;0.1 az login --tenant&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;device code if no browser is available&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="54" y="172" width="302" height="80" as="geometry"/></mxCell><mxCell id="p0_s1" value="&lt;b style=&quot;font-size:11px&quot;&gt;0.2 az account set + show&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;pin the subscription before any create&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=subscription;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="54" y="268" width="302" height="80" as="geometry"/></mxCell><mxCell id="p0_proof" value="&lt;b&gt;Proof:&lt;/b&gt; az account show returns the intended tenant and subscription; nothing created yet." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F9F1;strokeColor=#107C10;strokeWidth=1;fontSize=10;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="54" y="388" width="302" height="50" as="geometry"/></mxCell><mxCell id="p1" value="Phase 1 - Variables and naming&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#605E5C&quot;&gt;typical 5 min&lt;/font&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="330" height="340" as="geometry"/></mxCell><mxCell id="p1_s0" value="&lt;b style=&quot;font-size:11px&quot;&gt;1.1 Pick example + suffix&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;voice-live-api, realtime-api or foundry-voice-agent&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="414" y="172" width="302" height="80" as="geometry"/></mxCell><mxCell id="p1_s1" value="&lt;b style=&quot;font-size:11px&quot;&gt;1.2 Derive names&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;rg-, log-, cae-, cr, id-, ais-, ca-web-&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=resource-group;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="414" y="268" width="302" height="80" as="geometry"/></mxCell><mxCell id="p1_proof" value="&lt;b&gt;Proof:&lt;/b&gt; one consistent suffix; ACR name lowercase, no hyphens, globally unique." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F9F1;strokeColor=#107C10;strokeWidth=1;fontSize=10;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="414" y="388" width="302" height="50" as="geometry"/></mxCell><mxCell id="p2" value="Phase 2 - Base Azure resources&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#605E5C&quot;&gt;typical 20-30 min&lt;/font&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=resource-group;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="1100" height="340" as="geometry"/></mxCell><mxCell id="p2_s0" value="&lt;b style=&quot;font-size:11px&quot;&gt;2.1 Resource group&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;az group create&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=resource-group;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="774" y="172" width="528" height="56" as="geometry"/></mxCell><mxCell id="p2_s1" value="&lt;b style=&quot;font-size:11px&quot;&gt;2.2 Log Analytics workspace&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;capture customer id and shared key&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=log-analytics;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1318" y="172" width="528" height="56" as="geometry"/></mxCell><mxCell id="p2_s2" value="&lt;b style=&quot;font-size:11px&quot;&gt;2.3 Container Apps environment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;attached to the workspace&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=container-apps-environment;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="774" y="244" width="528" height="56" as="geometry"/></mxCell><mxCell id="p2_s3" value="&lt;b style=&quot;font-size:11px&quot;&gt;2.4 Container Registry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;Basic SKU, admin user disabled&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1318" y="244" width="528" height="56" as="geometry"/></mxCell><mxCell id="p2_s4" value="&lt;b style=&quot;font-size:11px&quot;&gt;2.5 User-assigned identity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;the app identity&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=managed-identity;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="774" y="316" width="528" height="56" as="geometry"/></mxCell><mxCell id="p2_s5" value="&lt;b style=&quot;font-size:11px&quot;&gt;2.6 AcrPull role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;identity pulls from the registry&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1318" y="316" width="528" height="56" as="geometry"/></mxCell><mxCell id="p2_proof" value="&lt;b&gt;Proof:&lt;/b&gt; resource group, workspace, environment, ACR and identity exist; identity has AcrPull." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F9F1;strokeColor=#107C10;strokeWidth=1;fontSize=10;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="774" y="388" width="1072" height="50" as="geometry"/></mxCell><mxCell id="p3" value="Phase 3 - Foundry, RBAC, model&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#605E5C&quot;&gt;typical 15-20 min&lt;/font&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;fontFamily=Segoe UI;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="400" height="410" as="geometry"/></mxCell><mxCell id="p3_s0" value="&lt;b style=&quot;font-size:11px&quot;&gt;3.1 Foundry AIServices&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;S0, custom subdomain, disableLocalAuth=true&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="54" y="552" width="372" height="56" as="geometry"/></mxCell><mxCell id="p3_s1" value="&lt;b style=&quot;font-size:11px&quot;&gt;3.2 Role assignments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;per example; identity and deployer (propagation 5-10 min)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="54" y="624" width="372" height="56" as="geometry"/></mxCell><mxCell id="p3_s2" value="&lt;b style=&quot;font-size:11px&quot;&gt;3.2b Project + agent version&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;project voice-agents, scripts\create-voice-agent.py&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=foundry-project;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="54" y="696" width="372" height="56" as="geometry"/></mxCell><mxCell id="p3_s2_p" value="VOICE AGENT" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="332" y="687" width="86" height="18" as="geometry"/></mxCell><mxCell id="p3_s3" value="&lt;b style=&quot;font-size:11px&quot;&gt;3.3 Model deployment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;Global Standard; skipped for the managed-model examples&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=foundry-models;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="54" y="768" width="372" height="56" as="geometry"/></mxCell><mxCell id="p3_s3_p" value="REALTIME ONLY" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="319" y="759" width="99" height="18" as="geometry"/></mxCell><mxCell id="p3_proof" value="&lt;b&gt;Proof:&lt;/b&gt; account has a custom subdomain, local auth is off, RBAC present; Realtime deployment listed." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F9F1;strokeColor=#107C10;strokeWidth=1;fontSize=10;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="54" y="838" width="372" height="50" as="geometry"/></mxCell><mxCell id="p4" value="Phase 4 - Build image&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#605E5C&quot;&gt;typical 5-10 min&lt;/font&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="470" y="490" width="300" height="410" as="geometry"/></mxCell><mxCell id="p4_s0" value="&lt;b style=&quot;font-size:11px&quot;&gt;4.1 az acr build&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;run from the repo root, -f examples\&lt;ex&gt;\Dockerfile&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="484" y="552" width="272" height="80" as="geometry"/></mxCell><mxCell id="p4_s1" value="&lt;b style=&quot;font-size:11px&quot;&gt;4.2 Context is the repo root&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;shared\, config\ and the example are copied&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=folder;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="484" y="648" width="272" height="80" as="geometry"/></mxCell><mxCell id="p4_proof" value="&lt;b&gt;Proof:&lt;/b&gt; ACR repository contains web:latest; context was the repo root." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F9F1;strokeColor=#107C10;strokeWidth=1;fontSize=10;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="484" y="838" width="272" height="50" as="geometry"/></mxCell><mxCell id="p5" value="Phase 5 - Create Container App&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#605E5C&quot;&gt;typical 10 min&lt;/font&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="800" y="490" width="400" height="410" as="geometry"/></mxCell><mxCell id="p5_s0" value="&lt;b style=&quot;font-size:11px&quot;&gt;5.1 az containerapp create&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;UAMI registry auth, external ingress :8000, 1 vCPU / 2 GiB, min=max=1&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="814" y="552" width="372" height="56" as="geometry"/></mxCell><mxCell id="p5_s1" value="&lt;b style=&quot;font-size:11px&quot;&gt;5.2 Per-example env vars&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;endpoint, model, voice, AZURE_CLIENT_ID, MAX_CONCURRENT_SESSIONS&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="814" y="624" width="372" height="56" as="geometry"/></mxCell><mxCell id="p5_s2" value="&lt;b style=&quot;font-size:11px&quot;&gt;5.3 Add probes by hand&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;liveness and readiness on /healthz for Bicep parity&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="814" y="696" width="372" height="56" as="geometry"/></mxCell><mxCell id="p5_s2_p" value="OPTIONAL" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1111" y="687" width="67" height="18" as="geometry"/></mxCell><mxCell id="p5_s3" value="&lt;b style=&quot;font-size:11px&quot;&gt;5.4 curl /healthz and /api/info&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;status ok; expected API, model, voice&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="814" y="768" width="372" height="56" as="geometry"/></mxCell><mxCell id="p5_proof" value="&lt;b&gt;Proof:&lt;/b&gt; app uses the UAMI for registry pulls, ingress external on 8000, /healthz returns status ok." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F9F1;strokeColor=#107C10;strokeWidth=1;fontSize=10;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="814" y="838" width="372" height="50" as="geometry"/></mxCell><mxCell id="po" value="Optional - Phone channels&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#605E5C&quot;&gt;after Phase 5&lt;/font&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=communication-services;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1230" y="490" width="300" height="410" as="geometry"/></mxCell><mxCell id="po_s0" value="&lt;b style=&quot;font-size:11px&quot;&gt;Generate secrets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;32 random bytes, URL-safe&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;stro