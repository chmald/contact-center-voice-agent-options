e="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="b_h" value="&lt;b style=&quot;font-size:13px&quot;&gt;Connection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;idle timeout and slots&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="570" height="62" as="geometry"/></mxCell><mxCell id="b_d0" value="WebSocket drops&lt;br&gt;during long silence?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="650" y="215" width="240" height="120" as="geometry"/></mxCell><mxCell id="b_l0" value="&lt;b style=&quot;font-size:11px&quot;&gt;Mind the idle timeout&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;ACA idle timeout is 4 min; app pings every 20 s; raise requestIdleTimeout or keep turns active&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAFFFA;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="220" width="280" height="110" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#107C10;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_d0" target="b_l0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c11"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="b_d1" value="Browser says all&lt;br&gt;agents are busy&lt;br&gt;(close 1013)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="650" y="385" width="240" height="120" as="geometry"/></mxCell><mxCell id="b_l1" value="&lt;b style=&quot;font-size:11px&quot;&gt;Raise the session cap&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;MAX_CONCURRENT_SESSIONS is per replica and replicas are fixed at 1; redo the TPM math after raising&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAFFFA;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="390" width="280" height="110" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#107C10;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_d1" target="b_l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c12"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#A4262C;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_d0" target="b_d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13_l" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#A4262C;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c13"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="b_end" value="No match: try column 3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.2;fontSize=10;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="535" width="570" height="52" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#A4262C;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.21052631578947367;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_d1" target="b_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14_l" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#A4262C;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c14"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c_note" value="&lt;b&gt;Still not matched?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Probe the service without the browser or phone path:&lt;br&gt;&amp;bull; python scripts\probe-voice-agent.py (voice agent)&lt;br&gt;&amp;bull; python scripts\probe-asterisk.py (Asterisk)&lt;br&gt;&amp;bull; python loadtest\concurrency_probe.py (any example)&lt;br&gt;&lt;br&gt;Then check load, limits and shared-resource throttling on page 5, or escalate with the output attached." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1250" y="215" width="570" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 Load, limits and escalation"><mxGraphModel dx="1900" dy="990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1900" height="6" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1040" y="0" width="860" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Load, service limits and escalation&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Page 5 of 6. Throttling and capacity symptoms, then what to collect and where to raise it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1820" height="40" as="geometry"/></mxCell><mxCell id="footer" value="Voice Live vs Realtime API  |  Troubleshooting decision tree  |  v1.4.2  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1820" height="20" as="geometry"/></mxCell><mxCell id="legend_0" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1820" height="44" as="geometry"/></mxCell><mxCell id="legend_t_0" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="852" width="60" height="20" as="geometry"/></mxCell><mxCell id="c1" value="GA" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="116" y="853" width="40" height="18" as="geometry"/></mxCell><mxCell id="c2" value="Voice Live and Realtime" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="160" y="852" width="142" height="20" as="geometry"/></mxCell><mxCell id="c3" value="PREVIEW" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="312" y="853" width="60" height="18" as="geometry"/></mxCell><mxCell id="c4" value="Foundry voice agent" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="376" y="852" width="120" height="20" as="geometry"/></mxCell><mxCell id="howto_4" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Columns 1 and 2 are decisions; column 3 is the terminal Escalation leaf with the evidence list and the four places to raise a case." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="1820" height="52" as="geometry"/></mxCell><mxCell id="a_h" value="&lt;b style=&quot;font-size:13px&quot;&gt;Throttling under load&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;TPM, RPM and NCPM&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="570" height="62" as="geometry"/></mxCell><mxCell id="a_d0" value="Long pauses under&lt;br&gt;load before errors?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="50" y="215" width="240" height="120" as="geometry"/></mxCell><mxCell id="a_l0" value="&lt;b style=&quot;font-size:11px&quot;&gt;Find the TPM ceiling&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;Run loadtest\concurrency_probe.py; reduce tokens per call, lower concurrency, raise quota or capacity&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAFFFA;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="280" height="110" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#107C10;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d0" target="a_l0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="a_d1" value="Realtime or Voice&lt;br&gt;Live returns 429s?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="50" y="385" width="240" height="120" as="geometry"/></mxCell><mxCell id="a_l1" value="&lt;b style=&quot;font-size:11px&quot;&gt;Lower the pressure&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;Lower concurrency and tokens per turn, or request quota&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAFFFA;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=azure-openai;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="390" width="280" height="110" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#107C10;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d1" target="a_l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c6"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#A4262C;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d0" target="a_d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7_l" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#A4262C;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c7"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="a_d2" value="Voice Live fails at&lt;br&gt;high connection&lt;br&gt;rates?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="50" y="555" width="240" height="120" as="geometry"/></mxCell><mxCell id="a_l2" value="&lt;b style=&quot;font-size:11px&quot;&gt;Size to service limits&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;100 new connections/min, 120K TPM, 60-minute sessions; request an NCPM increase if needed&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAFFFA;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=speech;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="560" width="280" height="110" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#107C10;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d2" target="a_l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c8"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#A4262C;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d1" target="a_d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9_l" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#A4262C;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c9"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="a_end" value="No match: try column 2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.2;fontSize=10;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="50" y="705" width="570" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#A4262C;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.21052631578947367;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d2" target="a_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10_l" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#A4262C;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c10"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="b_h" value="&lt;b style=&quot;font-size:13px&quot;&gt;Shared resource&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;one Foundry for two options&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="570" height="62" as="geometry"/></mxCell><mxCell id="b_d0" value="Voice Live and the&lt;br&gt;voice agent throttle&lt;br&gt;each other?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="650" y="215" width="240" height="120" as="geometry"/></mxCell><mxCell id="b_l0" value="&lt;b style=&quot;font-size:11px&quot;&gt;Run them one at a time&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;The shared platform uses one Foundry resource for both managed-model options; use separate resources for capacity tests&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAFFFA;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="220" width="280" height="110" as="geometry"/></mxCell><mxCell id="b_l0_p" value="PREVIEW" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1152" y="211" width="60" height="18" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#107C10;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_d0" target="b_l0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c11"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="b_end" value="No match: escalate (right)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.2;fontSize=10;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="650" y="365" width="570" height="52" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#A4262C;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.21052631578947367;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_d0" target="b_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12_l" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#A4262C;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c12"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="esc" value="&lt;b style=&quot;font-size:13px&quot;&gt;Escalation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;terminal leaf: attach evidence, then raise&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8F8;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=log-analytics;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1250" y="120" width="570" height="62" as="geometry"/></mxCell><mxCell id="esc_ev" value="&lt;b&gt;Collect before escalating&lt;/b&gt;&lt;br&gt;&amp;bull; Probe JSON: loadtest\results-&amp;lt;api&amp;gt;-&amp;lt;model&amp;gt;.json&lt;br&gt;&amp;bull; App turn logs: Log Analytics query for voice_turn lines&lt;br&gt;&amp;bull; Upstream request IDs from error payloads&lt;br&gt;&amp;bull; Region: azd env get-value AZURE_LOCATION&lt;br&gt;&amp;bull; Model and version: azd env get-values; deployment list; VOICE_AGENT_NAME / _VERSION&lt;br&gt;&amp;bull; Quota: az cognitiveservices usage list -l &amp;lt;region&amp;gt;, portal screenshot&lt;br&gt;&amp;bull; Container app config: az containerapp show -o json" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1250" y="215" width="570" height="250" as="geometry"/></mxCell><mxCell id="esc_where" value="&lt;b&gt;Where to raise it&lt;/b&gt;&lt;br&gt;&amp;bull; Azure support: persistent failures, quota denials, regional capacity, 401/403 after verified RBAC propagation&lt;br&gt;&amp;bull; Azure OpenAI quota request form: Realtime capacity&lt;br&gt;&amp;bull; Azure support: Voice Live new-connections-per-minute increase (also covers the voice agent)&lt;br&gt;&amp;bull; Repo issue: reproducible bridge, UI or script bugs with a minimal failing command and the probe JSON" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1250" y="485" width="570" height="220" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#A4262C;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.704;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_end" target="esc_ev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13_l" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#A4262C;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c13"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6 Asterisk phone channel"><mxGraphModel dx="1900" dy="990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1900" height="6" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1040" y="0" width="860" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Asterisk phone-channel failures&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Page 6 of 6. Eight symptoms from the Asterisk and app logs. Probe the endpoint first: python scripts\probe-asterisk.py --url wss://&amp;lt;app-fqdn&amp;gt;/telephony/asterisk/media." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1820" height="40" as="geometry"/></mxCell><mxCell id="footer" value="Voice Live vs Realtime API  |  Troubleshooting decision tree  |  v1.4.2  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1820" height="20" as="geometry"/></mxCell><mxCell id="legend_0" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="1820" height="44" as="geometry"/></mxCell><mxCell id="legend_t_0" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="852" width="60" height="20" as="geometry"/></mxCell><mxCell id="c1" value="GA" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="116" y="853" width="40" height="18" as="geometry"/></mxCell><mxCell id="c2" value="Voice Live and Realtime" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="160" y="852" width="142" height="20" as="geometry"/></mxCell><mxCell id="c3" value="PREVIEW" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="312" y="853" width="60" height="18" as="geometry"/></mxCell><mxCell id="c4" value="Foundry voice agent" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="376" y="852" width="120" height="20" as="geometry"/></mxCell><mxCell id="howto_4" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;Phone calls are an opt-in, DIY-bridged channel and are static-only in the CHANGELOG record: no live ACS, Twilio or Asterisk call is recorded." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="1820" height="52" as="geometry"/></mxCell><mxCell id="a_h" value="&lt;b style=&quot;font-size:13px&quot;&gt;Transport and TLS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;what Asterisk logs on connect&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=communication-services;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="570" height="62" as="geometry"/></mxCell><mxCell id="a_d0" value="Log shows 'Bad status&lt;br&gt;line' with a ws://&lt;br&gt;uri?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="50" y="215" width="240" height="120" as="geometry"/></mxCell><mxCell id="a_l0" value="&lt;b style=&quot;font-size:11px&quot;&gt;Use wss:// with SNI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#605E5C&quot;&gt;wss://&amp;lt;app-fqdn&amp;gt;/..., or the local TLS proxy (stunnel); never plain ws:// to the internet&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FAFFFA;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=communication-services;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="340" y="220" width="280" height="110" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;strokeWidth=2;strokeColor=#107C10;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_d0" target="a_l0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#107C10;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c5"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="a_d1" value="'Unable to set up ssl&lt;br&gt;connection' / reset&lt;br&gt;by peer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=2;fontSize=10;fontStyle=1;fontColor=#201F1E;fontFamily=Segoe UI;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="50" y="385" width="240" height="120" as="geometry"/></mxCell><mxCell id="a_l1" value="&lt;b style=&quot;font-size:11p