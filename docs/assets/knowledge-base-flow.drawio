        </mxCell>
        <mxCell id="subtitle" value="One handler and one index serve the browser, ACS, Twilio and Asterisk channels in all three apps. Azure AI Search is optional; local JSON is the default." style="text;html=1;fontSize=13;fontStyle=0;fontColor=#605E5C;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
