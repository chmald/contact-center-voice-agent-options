        <mxCell id="title" value="&lt;b&gt;Knowledge base flow: synthetic data to Azure AI Search to knowledge_search on every channel&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1">
