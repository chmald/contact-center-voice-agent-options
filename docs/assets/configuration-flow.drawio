e=&quot;font-size:12px&quot;&gt;.env.local&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;includes local-only keys (*_API_KEY, ACS_CONNECTION_STRING)&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="420" height="72" as="geometry"/></mxCell><mxCell id="t_el_p" value="LOCAL ONLY" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="392" y="511" width="80" height="18" as="geometry"/></mxCell><mxCell id="t_rl" value="&lt;b style=&quot;font-size:12px&quot;&gt;scripts\run-local.ps1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;loads .env.local for a local run&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=54;spacingRight=6;iconKey=powershell;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="420" height="72" as="geometry"/></mxCell><mxCell id="t_la" value="&lt;b style=&quot;font-size:12px&quot;&gt;App on localhost&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;reads the same variable names&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strok