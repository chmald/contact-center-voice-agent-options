0;" edge="1" parent="1" source="t_rl" target="t_la"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_l2_l" value="starts" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#605E5C;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e_l2"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="vg_t" value="&lt;b&gt;Variables by component&lt;/b&gt;  (each reaches the app through one of the paths above)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="622" width="1820" height="28" as="geometry"/></mxCell><mxCell id="g_reg" value="&lt;b style=&quot;font-size:13px&quot;&gt;Region and identity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;all projects&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="664" width="440" height="56" as="geometry"/></mxCell><mxCell id="g_reg_p" value="DEPLOY" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="418" y="655" width="54" height="18" as="geometry"/></mxCell><mxCell id="g_reg_b" value="&lt;b&gt;AZURE_TENANT_ID&lt;/b&gt;, &lt;b&gt;AZURE_SUBSCRIPTION_ID&lt;/b&gt;: set explicitly before any azd command&lt;br&gt;&lt;b&gt;AZURE_LOCATION&lt;/b&gt; = AI region: Foundry, realtime deployment, Voice Live, voice agent project, AI Search&lt;br&gt;&lt;b&gt;AZURE_APP_LOCATION&lt;/b&gt; = app region: Container Apps, ACR, Log Analytics, app identity (empty = AZURE_LOCATION). Same value for all three examples; changing it needs azd down --purge&lt;br&gt;AZURE_ENV_NAME, AZURE_PRINCIPAL_ID / AZURE_PRINCIPAL_TYPE&lt;br&gt;AZURE_CLIENT_ID (runtime, set by Bicep)&lt;br&gt;Shared mode: SHARED_RESOURCE_GROUP, SHARED_FOUNDRY_NAME, SHARED_FOUNDRY_PROJECT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="440" height="190" as="geometry"/></mxCell><mxCell id="g_com" value="&lt;b style=&quot;font-size:13px&quot;&gt;Common app settings&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;runtime, all examples&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="500" y="664" width="440" height="56" as="geometry"/></mxCell><mxCell id="g_com_p" value="RUNTIME" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="872" y="655" width="60" height="18" as="geometry"/></mxCell><mxCell id="g_com_b" value="&lt;b&gt;MAX_CONCURRENT_SESSIONS&lt;/b&gt; (20, per replica)&lt;br&gt;&lt;b&gt;LOG_LEVEL&lt;/b&gt; (DEBUG logs PII)&lt;br&gt;&lt;b&gt;AGENT_PROFILE_PATH&lt;/b&gt; (/app/config/agent-profile.json)&lt;br&gt;STATIC_DIR, SERVICE_WEB_RESOURCE_EXISTS&lt;br&gt;Config files: config\agent-profile.json and config\knowledge-base.json" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="500" y="728" width="440" height="190" as="geometry"/></mxCell><mxCell id="g_vl" value="&lt;b style=&quot;font-size:13px&quot;&gt;Voice Live API example&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;managed model, per-resource limits&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=speech;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="960" y="664" width="440" height="56" as="geometry"/></mxCell><mxCell id="g_vl_p" value="GA" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1352" y="655" width="40" height="18" as="geometry"/></mxCell><mxCell id="g_vl_b" value="&lt;b&gt;Model&lt;/b&gt;: VOICE_LIVE_MODEL (gpt-realtime-mini)&lt;br&gt;&lt;b&gt;Session&lt;/b&gt;: VOICE_LIVE_VOICE, VOICE_LIVE_TURN_DETECTION, VOICE_LIVE_TRANSCRIPTION_MODEL, VOICE_LIVE_TEMPERATURE&lt;br&gt;&lt;b&gt;Project&lt;/b&gt;: VOICE_LIVE_PROJECT_NAME (voice-agents)&lt;br&gt;&lt;b&gt;Endpoint&lt;/b&gt;: VOICE_LIVE_ENDPOINT (set by Bicep), VOICE_LIVE_API_VERSION (2026-07-15)&lt;br&gt;VOICE_LIVE_API_KEY (local only)&lt;br&gt;No capacity variable: limits are per resource" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="960" y="728" width="440" height="190" as="geometry"/></mxCell><mxCell id="g_rt" value="&lt;b style=&quot;font-size:13px&quot;&gt;Realtime API example&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;your deployment and quota&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=azure-openai;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1420" y="664" width="440" height="56" as="geometry"/></mxCell><mxCell id="g_rt_p" value="GA" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1812" y="655" width="40" height="18" as="geometry"/></mxCell><mxCell id="g_rt_b" value="&lt;b&gt;Model&lt;/b&gt;: AZURE_OPENAI_REALTIME_MODEL (gpt-realtime-2.1-mini), AZURE_OPENAI_REALTIME_MODEL_VERSION, AZURE_OPENAI_REALTIME_DEPLOYMENT&lt;br&gt;&lt;b&gt;Capacity&lt;/b&gt;: REALTIME_DEPLOYMENT_CAPACITY (default 10 units = 100K TPM), REALTIME_VERSION_UPGRADE_OPTION&lt;br&gt;&lt;b&gt;Session&lt;/b&gt;: REALTIME_VOICE (marin), REALTIME_TURN_DETECTION, REALTIME_NOISE_REDUCTION, REALTIME_TRANSCRIPTION_DEPLOYMENT&lt;br&gt;&lt;b&gt;Project&lt;/b&gt;: REALTIME_PROJECT_NAME&lt;br&gt;&lt;b&gt;Endpoint and auth&lt;/b&gt;: AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_TOKEN_SCOPE, AZURE_OPENAI_API_KEY (local only)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1420" y="728" width="440" height="190" as="geometry"/></mxCell><mxCell id="g_va" value="&lt;b style=&quot;font-size:13px&quot;&gt;Foundry voice agent example&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;agent owned by a Foundry project&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=foundry-agent-service;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="590" height="56" as="geometry"/></mxCell><mxCell id="g_va_p" value="PREVIEW" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="562" y="941" width="60" height="18" as="geometry"/></mxCell><mxCell id="g_va_b" value="&lt;b&gt;Agent&lt;/b&gt;: VOICE_AGENT_MODEL, VOICE_AGENT_VOICE, VOICE_AGENT_NAME (voice-agent-demo), VOICE_AGENT_PROJECT_NAME, VOICE_AGENT_VERSION (empty = latest)&lt;br&gt;&lt;b&gt;Endpoints&lt;/b&gt;: VOICE_AGENT_PROJECT, VOICE_AGENT_PROJECT_ENDPOINT (written by the postprovision hook), VOICE_AGENT_ENDPOINT&lt;br&gt;&lt;b&gt;Route&lt;/b&gt;: VOICE_AGENT_ROUTE = project (default, verified live); voice-live fails with close code 1008&lt;br&gt;&lt;b&gt;API versions&lt;/b&gt;: VOICE_AGENT_API_VERSION, VOICE_AGENT_PROJECT_API_VERSION (2025-11-15-preview)&lt;br&gt;&lt;b&gt;Audio&lt;/b&gt;: VOICE_AGENT_SEND_SESSION_CONFIG (false), VOICE_AGENT_TURN_DETECTION, VOICE_AGENT_TRANSCRIPTION_MODEL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="40" y="1014" width="590" height="150" as="geometry"/></mxCell><mxCell id="g_rag" value="&lt;b style=&quot;font-size:13px&quot;&gt;RAG (knowledge search)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;optional Azure AI Search backend&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="655" y="950" width="590" height="56" as="geometry"/></mxCell><mxCell id="g_rag_p" value="OPT-IN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1183" y="941" width="54" height="18" as="geometry"/></mxCell><mxCell id="g_rag_b" value="&lt;b&gt;Backend choice&lt;/b&gt;: AZURE_SEARCH_ENDPOINT set by Bicep = Azure AI Search with managed identity; empty = local config\knowledge-base.json&lt;br&gt;&lt;b&gt;Search resource&lt;/b&gt;: AZURE_SEARCH_SERVICE_NAME, KNOWLEDGE_RESOURCE_GROUP, AZURE_SEARCH_SKU&lt;br&gt;&lt;b&gt;Query&lt;/b&gt;: AZURE_SEARCH_INDEX, AZURE_SEARCH_SEMANTIC_CONFIG, AZURE_SEARCH_API_VERSION, AZURE_SEARCH_API_KEY (local only)&lt;br&gt;scripts\use-knowledge-base.ps1 sets the Search values" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="655" y="1014" width="590" height="150" as="geometry"/></mxCell><mxCell id="g_tel" value="&lt;b style=&quot;font-size:13px&quot;&gt;Telephony (ACS, Twilio, Asterisk)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#605E5C&quot;&gt;optional phone channels&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=52;spacingRight=6;iconKey=communication-services;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1270" y="950" width="590" height="56" as="geometry"/></mxCell><mxCell id="g_tel_p" value="OPT-IN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1798" y="941" width="54" height="18" as="geometry"/></mxCell><mxCell id="g_tel_b" value="&lt;b&gt;Providers&lt;/b&gt;: TELEPHONY_PROVIDERS = acs, twilio, asterisk (empty = browser only)&lt;br&gt;&lt;b&gt;ACS&lt;/b&gt;: ACS_RESOURCE_NAME, ACS_ENDPOINT (managed identity), ACS_CONNECTION_STRING (local only)&lt;br&gt;&lt;b&gt;Secrets&lt;/b&gt;: TELEPHONY_WEBHOOK_SECRET, ACS_EVENTGRID_SECRET, TWILIO_AUTH_TOKEN, ASTERISK_WEBSOCKET_SECRET&lt;br&gt;&lt;b&gt;Local only&lt;/b&gt;: TWILIO_SKIP_SIGNATURE_VALIDATION&lt;br&gt;&lt;b&gt;Call handling&lt;/b&gt;: TELEPHONY_OVERFLOW_NUMBER, TELEPHONY_BUSY_MESSAGE, PUBLIC_BASE_URL (from the Container Apps domain), TELEPHONY_TOKEN_TTL_SECONDS (300), TELEPHONY_CALLBACK_TTL_SECONDS (14400)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1270" y="1014" width="590" height="150" as="geometry"/></mxCell><mxCell id="legend_0" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8C6C4;strokeWidth=1;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="40" y="1196" width="1820" height="44" as="geometry"/></mxCell><mxCell id="legend_t_0" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="1208" width="60" height="20" as="geometry"/></mxCell><mxCell id="c1" value="DEPLOY" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="116" y="1209" width="54" height="18" as="geometry"/></mxCell><mxCell id="c2" value="azd env set, passed to Bicep" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="174" y="1208" width="170" height="20" as="geometry"/></mxCell><mxCell id="c3" value="RUNTIME" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fill