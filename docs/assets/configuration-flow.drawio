e="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;strokeWidth=1.2;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=2;spacingBottom=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="1820" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>