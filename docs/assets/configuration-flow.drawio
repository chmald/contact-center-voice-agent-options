<mxfile host="Electron" version="26.0.0"><diagram id="p1" name="Configuration flow"><mxGraphModel dx="1900" dy="1370" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1370" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1900" height="6" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1040" y="0" width="860" height="6" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Configuration flow: where variables live and how they reach each component&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Deploy-time values go azd env, then Bicep, then the Container App; runtime values are set on the app by Bicep or come from .env.local for local runs. Source: docs/09." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1820" height="40" as="geometry"/></mxCell><mxCell id="footer" value="Voice Live vs Realtime API  |  Configuration flow  |  v1.4.2  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1820" height="20" as="geometry"/></mxCell><mxCell id="l_dep" value="Deploy path: azd to the Container App&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot; color=&quot;#605E5C&quot;&gt;set deploy-time values per project folder: platform\ or examples\&