        <mxCell id="rtd" value="&lt;b&gt;Realtime deployment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Global Standard, only deployment created&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=azure-openai;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1090" y="475" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="rtd_p" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1366" y="466" width="36" height="18" as="geometry" /></mxCell>
        <mxCell id="g_proj" value="Foundry project: voice-agents" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;spacingTop=8;fontFamily=Segoe UI;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=foundry-project;dashed=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1080" y="565" width="740" height="215" as="geometry" /></mxCell>
        <mxCell id="va" value="&lt;b&gt;Versioned voice agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;config + tool declarations&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=foundry-agent-service;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1090" y="685" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="va_p" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1336" y="676" width="66" height="18" as="geometry" /></mxCell>
        <mxCell id="sv_note" value="&lt;b&gt;Shared vs standalone&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Shared mode reuses this one Foundry resource through distinct hosts: &lt;code&gt;services.ai.azure.com&lt;/code&gt; for Voice Live and agent mode, &lt;code&gt;openai.azure.com&lt;/code&gt; for Realtime. Standalone mode gives each example its own Foundry resource and project.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;dashed=1;fontSize=11;fontColor=#201F1E;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1500" y="250" width="320" height="190" as="geometry" /></mxCell>
        <mxCell id="srch" value="&lt;b&gt;Azure AI Search&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;separate resource, 40 knowledge articles&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=ai-search;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1090" y="850" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="srch_p" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1354" y="841" width="70" height="18" as="geometry" /></mxCell>
        <mxCell id="how" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Each app tier owns its Container App, registry, logs and managed identity, and talks to the shared platform with its own identity. The dashed line to Search is the same RAG code running inside all three apps, not a fourth service. Without Search, the apps read the same 40 articles from &lt;code&gt;config\knowledge-base.json&lt;/code&gt;.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C8A400;dashed=1;fontSize=11;fontColor=#201F1E;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="910" width="870" height="80" as="geometry" /></mxCell>
