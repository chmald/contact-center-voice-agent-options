        <mxCell id="g_foundry" value="ONE Foundry resource (AIServices S0)" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;spacingTop=8;fontFamily=Segoe UI;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=foundry;dashed=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1060" y="170" width="780" height="640" as="geometry" /></mxCell>
