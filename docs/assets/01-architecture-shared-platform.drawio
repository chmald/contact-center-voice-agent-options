        <mxCell id="lg_ga" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="100" y="1001" width="36" height="18" as="geometry" /></mxCell>
        <mxCell id="lg_ga_t" value="Generally available" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="142" y="997" width="130" height="24" as="geometry" /></mxCell>
        <mxCell id="lg_pv" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="285" y="1001" width="66" height="18" as="geometry" /></mxCell>
        <mxCell id="lg_pv_t" value="Public preview, not for production" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="356" y="997" width="210" height="24" as="geometry" /></mxCell>
