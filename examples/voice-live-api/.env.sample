AZURE_LOCATION=centralus
# AZURE_APP_LOCATION=eastus2   # optional: Container Apps/ACR/Log Analytics region when ACA is constrained in AZURE_LOCATION
AZURE_TENANT_ID=<tenant-id>
AZURE_RESOURCE_GROUP=rg-<environment-name>
AZURE_CONTAINER_REGISTRY_ENDPOINT=<registry-name>.azurecr.io
AZURE_CONTAINER_REGISTRY_NAME=<registry-name>
SERVICE_WEB_NAME=ca-web-<suffix>
SERVICE_WEB_URI=https://<app>.<region>.azurecontainerapps.io
VOICE_LIVE_ENDPOINT=https://<foundry-resource>.services.ai.azure.com
VOICE_LIVE_MODEL=gpt-realtime-mini
VOICE_LIVE_VOICE=en-US-Ava:DragonHDLatestNeural
VOICE_LIVE_API_VERSION=2026-07-15
FOUNDRY_RESOURCE_NAME=ais-<suffix>
# VOICE_LIVE_API_KEY=

# --- Shared platform, RAG, and telephony (optional; see docs/07-telephony-and-shared-endpoint.md) ---
# SHARED_RESOURCE_GROUP=rg-<platform-env>
# SHARED_FOUNDRY_NAME=ais-<suffix>
# AZURE_SEARCH_SERVICE_NAME=srch-<suffix>
# AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# AZURE_SEARCH_INDEX=knowledge
# AZURE_SEARCH_SEMANTIC_CONFIG=default
# ACS_RESOURCE_NAME=acs-<suffix>
# TELEPHONY_PROVIDERS=acs,twilio
# TELEPHONY_WEBHOOK_SECRET=<generated-by-use-shared-platform.ps1>
# PUBLIC_BASE_URL=https://<public-tunnel-or-app-host>
# ACS_EVENTGRID_SECRET=<generated-by-use-shared-platform.ps1>
# ACS_ENDPOINT=https://<acs-resource>.<region>.communication.azure.com
# TWILIO_AUTH_TOKEN=<twilio-auth-token>
# TELEPHONY_OVERFLOW_NUMBER=+15555550100
